{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-ready-rust/repo-map.schema.json",
  "title": "Agent Ready Rust Repo Map",
  "type": "object",
  "required": ["version", "workspace", "crates"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "workspace": {
      "type": "object",
      "required": ["root", "edition"],
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "edition": { "type": "string" },
        "default_members": { "type": "array", "items": { "type": "string" } }
      }
    },
    "crates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "purpose", "owners"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "owners": { "type": "array", "items": { "type": "string" } },
          "entrypoints": { "type": "array", "items": { "type": "string" } },
          "generated_paths": { "type": "array", "items": { "type": "string" } },
          "forbidden_edits": { "type": "array", "items": { "type": "string" } },
          "local_instructions": { "type": "string" }
        }
      }
    }
  }
}

