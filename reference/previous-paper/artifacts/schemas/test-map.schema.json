{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-ready-rust/test-map.schema.json",
  "title": "Agent Ready Rust Test Map",
  "type": "object",
  "required": ["version", "lanes", "mappings"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "purpose"],
        "additionalProperties": false,
        "properties": {
          "name": { "enum": ["fast", "medium", "deep", "security", "release"] },
          "command": { "type": "string" },
          "purpose": { "type": "string" },
          "expected_runtime_seconds": { "type": "number" }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paths", "required_lanes"],
        "additionalProperties": false,
        "properties": {
          "paths": { "type": "array", "items": { "type": "string" } },
          "required_lanes": {
            "type": "array",
            "items": { "enum": ["fast", "medium", "deep", "security", "release"] }
          },
          "owner": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}

