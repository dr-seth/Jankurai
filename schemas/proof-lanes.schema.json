{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jankurai.dev/schemas/proof-lanes.schema.json",
  "title": "jankurai proof lanes manifest",
  "type": "object",
  "required": ["lane"],
  "properties": {
    "lane": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "purpose": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
