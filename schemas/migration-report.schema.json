{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanlint.dev/schemas/migration-report.schema.json",
  "title": "humanlint migration report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source_root",
    "source_stack",
    "target_stack",
    "liability_score",
    "module_inventory",
    "recommended_slice_order",
    "required_proof_lanes",
    "rollback_cutover_notes"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "source_root": { "type": "string" },
    "source_stack": { "type": "string" },
    "target_stack": { "type": "string" },
    "liability_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "module_inventory": {
      "type": "array",
      "items": { "type": "string" }
    },
    "owner_guesses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "external_boundaries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "db_surfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "api_surfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "duplicate_logic": {
      "type": "array",
      "items": { "type": "string" }
    },
    "high_risk_areas": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "strangler_candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_slice_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_proof_lanes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rollback_cutover_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
