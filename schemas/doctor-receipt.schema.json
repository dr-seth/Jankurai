{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanlint.dev/schemas/doctor-receipt.schema.json",
  "title": "humanlint doctor receipt",
  "type": "object",
  "required": ["action", "created_at", "diagnostics"],
  "properties": {
    "action": { "type": "string" },
    "created_at": { "type": "integer" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "severity", "path", "message"],
        "properties": {
          "check_id": { "type": "string" },
          "severity": { "type": "string" },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
